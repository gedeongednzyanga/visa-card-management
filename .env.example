# API interne "acces-register" (authentification du dashboard)
API_URL=http://localhost:3000/api

# API Partenaire KardPay — voir la doc KardPay section 2 (Getting access).
# Ne jamais commiter de vraies valeurs. KARDPAY_SECRET ne doit vivre que dans un
# secrets manager en production (Vault, AWS Secrets Manager, etc.), jamais en clair.
KARDPAY_BASE_URL=
KARDPAY_KEY_ID=
KARDPAY_SECRET=

# CBS BankSoft (Processware) — voir le plan technique, section "Modèle opérationnel".
# Ne jamais commiter de vraies valeurs. BANKSOFT_AES_KEY ne doit vivre que dans un
# secrets manager en production, jamais en clair.
BANKSOFT_BASE_URL=
BANKSOFT_API_KEY=
BANKSOFT_BEARER_TOKEN=
BANKSOFT_AES_KEY=
BANKSOFT_AES_IV=
